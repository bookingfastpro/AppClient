# --- Public (safe to ship to the browser, inlined at build time) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_, never ship to the client) ---
# Supabase's service role / "secret" key (starts with sb_secret_ on newer
# projects, or is the legacy service_role JWT on older ones).
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# The single super-admin account (by email) allowed into /admin to add
# YouTube-linked videos. Sign up with this email first, then it gains
# access automatically — no separate role table.
ADMIN_EMAIL=
